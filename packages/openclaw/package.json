{
  "name": "@provenance-guard/openclaw",
  "version": "0.0.1",
  "private": true,
  "description": "OpenClaw adapter for Provenance Guard (registry only so far)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@provenance-guard/core": "0.0.1"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  }
}
