{
  "name": "@provenance-guard/openclaw",
  "version": "0.1.0-beta.0",
  "description": "OpenClaw plugin: tracks where data came from and checks each tool argument's origin before risky actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanmay6461/openclaw-safety.git",
    "directory": "packages/openclaw"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "prompt-injection",
    "provenance",
    "agent-security"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE ../../README.md ."
  },
  "dependencies": {
    "@provenance-guard/core": "0.1.0-beta.0"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "runtimeExtensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.8",
      "minGatewayVersion": "2026.10.8"
    },
    "build": {
      "openclawVersion": "2026.10.8",
      "pluginSdkVersion": "2026.10.8"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.8"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
