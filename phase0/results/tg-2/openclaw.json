{
  "gateway": {
    "mode": "local",
    "port": 24876,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "pg-<REDACTED>"
    },
    "controlUi": {
      "enabled": false
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "mock": {
        "baseUrl": "http://127.0.0.1:24877/v1",
        "apiKey": "mock-key",
        "api": "openai-completions",
        "agentRuntime": {
          "id": "openclaw"
        },
        "request": {
          "allowPrivateNetwork": true
        },
        "timeoutSeconds": 60,
        "models": [
          {
            "id": "mock-model",
            "name": "Mock",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "mock/mock-model",
        "fallbacks": []
      },
      "models": {
        "mock/mock-model": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "workspace": "/localstate/state/workspace",
      "skipBootstrap": true,
      "timeoutSeconds": 120,
      "heartbeat": {
        "every": "0m"
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "host": "gateway",
      "mode": "full",
      "strictInlineEval": false
    },
    "web": {
      "fetch": {
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      }
    }
  },
  "skills": {
    "allowBundled": []
  },
  "plugins": {
    "enabled": true,
    "load": {
      "paths": [
        "/pg/guard-plugin/provenance-guard",
        "/pg/probe-plugin"
      ]
    },
    "entries": {
      "pg-probe": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "timeoutMs": 15000
        },
        "config": {
          "logPath": "/pg/runs/tg-2/probe.jsonl",
          "stampPersist": false,
          "raceTest": false,
          "approveTools": [
            "exec"
          ],
          "approveMatch": "pg-approve-low",
          "approvalTimeoutMs": 300000
        }
      },
      "provenance-guard": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "timeoutMs": 15000
        },
        "config": {
          "mode": "enforce",
          "preset": "balanced",
          "stateDir": "/pg/runs/tg-2/guard-state"
        }
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:7845032487"
    ]
  },
  "approvals": {
    "plugin": {
      "enabled": true,
      "mode": "session"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "tokenFile": "/localstate/state/telegram.token",
      "proxy": "http://10.99.0.130:3128",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "7845032487",
        "7419412584"
      ],
      "groupPolicy": "open",
      "groupAllowFrom": [
        "7845032487",
        "7419412584"
      ],
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "capabilities": {
        "inlineButtons": "all"
      },
      "execApprovals": {
        "enabled": true,
        "approvers": [
          "7845032487"
        ],
        "target": "both"
      }
    }
  }
}
