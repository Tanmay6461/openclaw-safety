[driver] c3-self-cli start
[driver] c3-self-cli inbound
[driver] c3-self-cli approval-prompt id=plugin:656d9b96-3acd-48e2-8af6-141ebcc20e2c
[driver] c3-self-cli cli
[driver] c3-self-cli resolution none within 10000ms
[driver] c3-self-cli echo-outbound
[driver] c3-self-cli inbound
[driver] c3-self-cli resolution decision=cancelled
[driver] c3-guard-echo start
[driver] c3-guard-echo cli
[driver] c3-guard-echo result handler=false
[driver] c4b-approvals-cli start
[driver] c4b-approvals-cli inbound
[driver] c4b-approvals-cli approval-prompt id=plugin:406028f9-512d-422b-a7b7-af92a136c1f9
[driver] c4b-approvals-cli cli
[driver] c4b-approvals-cli resolution decision=cancelled
[driver] d-spawn start
[driver] d-spawn inbound
[driver] d-spawn done
[driver] d-send start
[driver] d-send inbound
[driver] d-send done
[driver]  driver-done
