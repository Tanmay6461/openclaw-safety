{
  "gateway": {
    "mode": "local",
    "port": 26738,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<redacted-test-token>"
    },
    "controlUi": {
      "enabled": false
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "sk-pg-mock-not-a-real-key",
        "api": "openai-responses",
        "models": [
          {
            "id": "gpt-5.6-luna",
            "name": "gpt-5.6-luna",
            "api": "openai-responses",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-luna",
        "fallbacks": []
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "agentRuntime": {
            "id": "codex"
          }
        }
      },
      "workspace": "/pg/runs/codex-4/state/workspace",
      "skipBootstrap": true,
      "timeoutSeconds": 240,
      "heartbeat": {
        "every": "0m"
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.6-luna"
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "host": "gateway",
      "mode": "full",
      "strictInlineEval": false
    },
    "web": {
      "fetch": {
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      }
    }
  },
  "skills": {
    "allowBundled": []
  },
  "plugins": {
    "enabled": true,
    "load": {
      "paths": [
        "/pg/guard-plugin/provenance-guard",
        "/pg/probe-plugin"
      ]
    },
    "entries": {
      "pg-probe": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "timeoutMs": 15000
        },
        "config": {
          "logPath": "/pg/runs/codex-4/probe.jsonl",
          "stampPersist": false,
          "raceTest": false
        }
      },
      "provenance-guard": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "timeoutMs": 15000
        },
        "config": {
          "mode": "shadow",
          "preset": "balanced",
          "stateDir": "/pg/runs/codex-4/guard-state"
        }
      },
      "codex": {
        "enabled": true,
        "config": {
          "appServer": {
            "sandbox": "danger-full-access"
          }
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "openai-compatible",
      "model": "text-embedding-3-small",
      "remote": {
        "baseUrl": "http://127.0.0.1:26739/v1",
        "apiKey": "test"
      }
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.8"
  },
  "auth": {
    "profiles": {
      "pg-mock-openai": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  }
}
