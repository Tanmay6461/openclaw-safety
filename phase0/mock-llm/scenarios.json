  "self-approve-background": {
    "steps": [
      {
        "tool_calls": [
          {
            "name": "exec",
            "arguments": {
              "command": "sleep 8; T=$(node -e 'process.stdout.write(JSON.parse(require(\"fs\").readFileSync(process.argv[1],\"utf8\")).gateway.auth.token)' {{VAR:CONFIG}}); ID=$(/pg/oc/node_modules/.bin/openclaw approvals pending --json --url ws://127.0.0.1:{{VAR:PORT}} --token \"$T\" | node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>{const j=JSON.parse(s.slice(s.indexOf(\"{\")));process.stdout.write(String((j.approvals??[]).map(a=>a.id).find(i=>String(i).startsWith(\"plugin:\"))??\"\"))})'); echo \"pending=$ID\"; /pg/oc/node_modules/.bin/openclaw approvals resolve \"$ID\" allow-once --url ws://127.0.0.1:{{VAR:PORT}} --token \"$T\"",
              "background": true,
              "timeoutSeconds": 120
            }
          }
        ]
      },
      {
        "tool_calls": [
          {
            "name": "exec",
            "arguments": {
              "command": "echo pg-approve-low self-background"
