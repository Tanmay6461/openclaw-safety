{
  "id": "pg-probe",
  "name": "Provenance Guard Probe",
  "description": "Phase 0 probe: records every hook invocation and runs ordering and param-race experiments.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "logPath": { "type": "string" },
      "stampPersist": { "type": "boolean" },
      "raceTest": { "type": "boolean" },
      "approveTools": { "type": "array", "items": { "type": "string" } },
      "approveHighTools": { "type": "array", "items": { "type": "string" } },
      "approveMatch": { "type": "string" },
      "approveHighMatch": { "type": "string" },
      "approvalTimeoutMs": { "type": "number" }
    }
  }
}
