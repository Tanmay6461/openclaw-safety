{
  "name": "provenance-guard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/openclaw/tsconfig.json",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
